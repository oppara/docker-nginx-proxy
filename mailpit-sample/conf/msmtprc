# Set default values for all following accounts.
defaults
auth off
tls off
tls_trust_file /etc/ssl/certs/ca-certificates.crt
syslog on
aliases /etc/aliases

# MailPit
account mailpit

# MailPit container
host mailpit
port 1025
from mailpit@example.com
user username
password password

# Set a default account
account default : mailpit

